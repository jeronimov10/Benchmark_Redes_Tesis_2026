# Backend (FastAPI). Todas son opcionales: los valores por defecto funcionan sin claves.
DB_PATH=backend/data/redes.db
CORS_ORIGINS=http://localhost:3000
COLECTORES_ACTIVOS=true
REDES_ACTIVAS=tempo,aptos,canton,polygon,celo,arbitrum

# Endpoints de datos (sobrescribir con un proveedor propio si el publico limita o cae)
RPC_TEMPO=https://rpc.tempo.xyz
REST_APTOS=https://api.mainnet.aptoslabs.com/v1
SCAN_CANTON=https://api.cantonnodes.com
RPC_POLYGON=https://polygon.publicnode.com
RPC_CELO=https://forno.celo.org
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
HERMES_PYTH=https://hermes.pyth.network

# Intervalos (segundos) y ventanas
INTERVALO_BLOQUES_S=20
INTERVALO_FINALIDAD_S=0.3
INTERVALO_ESTADO_S=300
INTERVALO_METRICAS_S=30
VENTANA_FLUJO_S=900
VENTANA_DISTRIBUCION_S=86400
VENTANA_FINALIDAD_S=259200
VENTANA_CONTINUIDAD_S=1209600
OBSOLESCENCIA_S=900
REPLICAS_MONTE_CARLO=10000

# Frontend (Next.js): a donde reenvia /api/*
BACKEND_URL=http://127.0.0.1:8000
