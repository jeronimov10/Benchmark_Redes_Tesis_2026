---
title: Arquitectura y funcionamiento - monitor de redes y modelo de recomendacion
---
flowchart TB

  %% ============ 1. USO ============
  subgraph USO["1. Como se corre"]
    DK["docker compose up --build<br/>frontend :3000 - backend :8000<br/>volumen datos = SQLite"]
  end

  %% ============ 2. REDES ============
  subgraph REDES["2. Fuentes de datos - registro publico de cada red"]
    direction LR
    RT["Tempo<br/>JSON-RPC"]
    RA["Aptos<br/>REST + Pyth on-chain"]
    RC["Canton<br/>Scan API"]
    RE["Polygon - Celo - Arbitrum<br/>JSON-RPC"]
    RP["Chainlink on-chain<br/>precio ETH - MATIC - CELO"]
  end

  %% ============ 3. PIPELINE ============
  subgraph PIPE["3. Backend FastAPI - pipeline casi en tiempo real"]
    direction TB
    SCH["Scheduler asyncio<br/>una tarea por red y componente<br/>sin solapar ciclos - backoff - apagado limpio"]
    COL["Colectores<br/>timeout - reintentos exponenciales - 429<br/>bloques cada 20 s - estado cada 5 min<br/>finalidad Tempo cada 0.3 s"]
    PRO["Procesadores y validadores<br/>payload crudo a muestra normalizada<br/>segundos - USD - fracciones"]
    DB[("SQLite WAL<br/>muestras_bloque - muestras_tx<br/>muestras_finalidad - lecturas_estado<br/>metricas_vivo - perfiles_base<br/>salud_colector")]
    MET["Calculo de metricas cada 30 s<br/>ventanas moviles<br/>15 min - 24 h - 72 h - 14 d"]
    SCH --> COL --> PRO --> DB --> MET
    MET -->|"metricas_vivo con estado y n"| DB
  end

  %% ============ 4. LINEA BASE ============
  subgraph BASE["4. Linea base - respaldo de lo que no es vivo"]
    direction LR
    PJ["perfiles.json<br/>Polygon - Celo - Arbitrum<br/>90 dias - Dilan"]
    CSV["resultados/metrics.csv<br/>Tempo - Aptos - Canton<br/>convertido: A2 = p95/mediana<br/>B3 x 48/18 - C3 en % - C1 = C1b - sigma 0"]
    REC["Boton Recalibrar<br/>corre el benchmark por lotes<br/>y reconstruye la base de T/A/C"]
    REC -.-> CSV
  end

  %% ============ 5. METRICAS ============
  subgraph METR["5. Que metricas son en vivo y cuales no"]
    direction TB
    subgraph VIVO["EN VIVO - ventana movil, valida si hay n minimo y dato fresco menor a 15 min"]
      direction TB
      V1["Tempo - 12 a 14 de 14<br/>A1 A2 A3 B1 B3 C1 C2 C4 C5 D1 D2 D3<br/>B2 continuo: exige 72 h completas<br/>C3: exige 14 d completos"]
      V2["Aptos - 10<br/>A1 A2 A3 B1 B3 C1 C2 C4 D1 D3<br/>por muestreo de 6 bloques por ciclo"]
      V3["Canton - 13<br/>A1 A2 A3 B1 B2 B3 C1 C2 C4 D2 D3<br/>C3 y C5 exigen 14 d<br/>B3 es cota inferior"]
      V4["Polygon - Celo - Arbitrum - 9<br/>A1 A2 B1 C1 C2 C4 D1<br/>C3 y C5 exigen 14 d<br/>pagos USDC verificados"]
    end
    subgraph SOLOBASE["SOLO LINEA BASE - no se puede reproducir en vivo"]
      direction TB
      B1["Aptos: B2 imposible por HTTP - bloques de 20 ms<br/>D2 sin definicion A-5 - C3 y C5 sin cobertura"]
      B2["Canton: D1 declarado no aplica"]
      B3["Polygon - Celo - Arbitrum:<br/>A3 A4 B2 B2b B3 D2 D3<br/>requieren rastreador de anclaje en Ethereum<br/>o definiciones de la tesis no reproducibles"]
    end
  end

  %% ============ 6. COMO SE CALCULA ============
  subgraph CALC["6. Como se calcula cada metrica en vivo"]
    direction TB
    C1X["A1 A2 costo: gas x precio nativo, o tarifa en USD<br/>mediana y razon p95/mediana<br/>sigma por bootstrap"]
    C2X["A3 pendiente de ln costo contra ocupacion<br/>B1 p95 entre bloques consecutivos o veredicto<br/>B2 tau_F menos tau_1"]
    C3X["B3 capacidad: limite de gas o trafico / gas mediano / cadencia<br/>C1 C2 HHI y minimo de operadores con mas de 50 %<br/>validadores, ValidatorSet, pesos de super validators"]
    C4X["C3 huecos mayores a 10 veces la cadencia<br/>C4 fallos / transacciones - C5 cambios en 14 d<br/>D1 pago sin token nativo - D2 memo - D3 multi transferencia"]
  end

  %% ============ 7. PERFIL ============
  subgraph PERF["7. Perfil efectivo por red"]
    EF{"Metrica en vivo<br/>valida y fresca?"}
    SI["Usa valor en vivo<br/>origen = vivo con edad, n y ventana"]
    NO["Cae a la linea base<br/>origen = base y razon<br/>insuficiente - obsoleta - fallida - no computable"]
    VER["version_perfil = hash del perfil<br/>cambia si cambia cualquier entrada"]
    EF -->|si| SI --> VER
    EF -->|no| NO --> VER
  end

  %% ============ 8. MODELO ============
  subgraph MODELO["8. Modelo de la tesis - modelo.py sin modificar - pool de procesos"]
    direction TB
    M1["Entrada: monto COP - transfronterizo<br/>espera - irrevocabilidad - TRM - modo"]
    M2["Interpola pesos entre 3 escenarios<br/>remesas - comercio - alto valor<br/>certidumbre kappa"]
    M3["Compuertas G1 G2 G3 G4<br/>falla = red inadmisible con motivo<br/>G2: sin B2 no hay anclaje verificable"]
    M4["Puntaje por metrica 0 a 1 con umbrales<br/>media por bloque A B C D<br/>media geometrica ponderada<br/>metrica nula se excluye"]
    M5["Monte Carlo 10000 replicas<br/>ruido por sigma y pesos Dirichlet"]
    M6["Bandas: una red entra a la siguiente<br/>solo si gana en al menos 85 % de replicas<br/>determinante y advertencias"]
    M7{"Menos de 2 redes<br/>con datos?"}
    M8["estado = datos_insuficientes<br/>no se fabrica recomendacion"]
    M1 --> M2 --> M3 --> M4 --> M5 --> M6
    M1 --> M7
    M7 -->|si| M8
  end

  %% ============ 9. API Y FRONT ============
  subgraph SALIDA["9. API y frontend"]
    direction TB
    CACHE["Cache TTL + LRU<br/>clave = entrada + modo + version_perfil<br/>un dato nuevo invalida resultados viejos"]
    API["API /api<br/>salud - redes - mediciones - modelo - recalibracion"]
    FE["Frontend Next.js<br/>Monitoreo: salud, origen y edad de cada metrica<br/>Resultado: bandas, certidumbre, etiqueta En vivo o Base<br/>estados: cargando - ok - obsoleto - insuficiente - error"]
    CACHE --> API --> FE
  end

  DK --> PIPE
  RT --> COL
  RA --> COL
  RC --> COL
  RE --> COL
  RP --> COL
  MET --> VIVO
  VIVO --> CALC
  PJ --> DB
  CSV --> DB
  DB --> EF
  SOLOBASE --> NO
  VER --> M1
  M6 --> CACHE
  M8 --> CACHE
  FE -->|"POST /api/modelo"| M1
  FE -.->|"boton Recalibrar"| REC

  classDef vivo fill:#e6f7ea,stroke:#2a9d4a,color:#000
  classDef base fill:#fff3d6,stroke:#c98a00,color:#000
  classDef modelo fill:#e8eefc,stroke:#3b5bdb,color:#000
  class V1,V2,V3,V4,SI vivo
  class B1,B2,B3,NO,PJ,CSV base
  class M1,M2,M3,M4,M5,M6 modelo
