# Imagen del backend para Railway (FastAPI + colectores + banco de usuarios simulados). Contexto: la raiz del repositorio. Sin CAs extra ni VOLUME
# (Railway monta el volumen en /app/backend/data) y con el puerto inyectado por Railway en $PORT.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend backend
COPY resultados resultados

WORKDIR /app/backend
CMD ["sh", "-c", "exec python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
